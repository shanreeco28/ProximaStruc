rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.get('ownerId', '') == request.auth.uid;
    }
    // Site owners (website masters) are designated only through the Firebase Console or Admin SDK:
    // siteOwners/{uid} cannot be written from the app. They create and delete projects and act as admin everywhere.
    function siteOwner() {
      return signedIn() && exists(/databases/$(database)/documents/siteOwners/$(request.auth.uid));
    }
    function superuser(projectId) { return owner(projectId) || siteOwner(); }
    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) && request.auth.token.get('email', '') != '';
    }
    function role(projectId) {
      return verifiedEmail() && exists(/databases/$(database)/documents/artifacts/$(projectId)/users/$(request.auth.token.email.lower()))
        ? get(/databases/$(database)/documents/artifacts/$(projectId)/users/$(request.auth.token.email.lower())).data.get('systemRole', 'guest') : '';
    }
    function admin(projectId) { return superuser(projectId) || role(projectId) == 'admin'; }
    function planner(projectId) { return superuser(projectId) || role(projectId) in ['admin', 'manager', 'engineer']; }
    function siteRecorder(projectId) { return planner(projectId) || role(projectId) == 'supervisor'; }
    function member(projectId) { return superuser(projectId) || role(projectId) in ['guest', 'supervisor', 'engineer', 'manager', 'RE', 'RTO', 'admin']; }
    // createdByName is the display name of the person who opened the record ("Created by" on every record).
    function auditCreate() {
      return request.resource.data.createdBy == request.auth.token.email && request.resource.data.createdAt is string
        && request.resource.data.get('createdByName', '') is string && request.resource.data.get('createdByName', '').size() <= 200;
    }
    function auditUpdate() {
      return request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.updatedBy == request.auth.token.email && request.resource.data.updatedAt is string;
    }
    function validTask() {
      let d = request.resource.data;
      return d.activity is string && d.activity.size() > 0 && d.zone is string && d.owner is string
        && d.startDate is string && d.endDate is string && d.endDate >= d.startDate
        && d.progress is number && d.progress >= 0 && d.progress <= 100
        && d.status in ['lookahead', 'make_ready', 'in_progress', 'blocked', 'done', 'Backlog', 'Ready', 'In progress', 'Blocked', 'Done']
        && (!(d.status in ['done', 'Done']) || d.progress == 100);
    }
    function validMaterial() {
      let d = request.resource.data;
      return d.type in ['BBS', 'Concrete', 'Delivery Order'] && d.reference is string && d.reference.size() > 0
        && d.quantity is number && d.quantity > 0 && d.unit is string && d.unit.size() > 0
        && d.status in ['Planned', 'Ordered', 'Dispatched', 'Received', 'Delayed', 'Rejected', 'Installed', 'Poured']
        && (!(d.status in ['Received', 'Installed', 'Poured']) || (d.doNumber is string && d.doNumber.size() > 0 && d.actualDate is string && d.actualDate.size() > 0));
    }
    function selfProfile(projectId, recordId) {
      let d = request.resource.data;
      return verifiedEmail() && recordId == request.auth.token.email.lower() && d.email == recordId
        && d.systemRole == 'pending'
        && d.keys().hasOnly(['name', 'email', 'role', 'birthday', 'organization', 'category', 'statutoryReg', 'certExpiry', 'bizSafe', 'cdePermission', 'ptwAuthority', 'systemRole', 'createdBy', 'createdAt'])
        && d.organization == '' && d.category == '' && d.statutoryReg == '' && d.certExpiry == '' && d.bizSafe == ''
        && d.cdePermission == 'Project member' && d.ptwAuthority == []
        && exists(/databases/$(database)/documents/projects/$(projectId));
    }
    function appendOnly(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data[field];
      return after is list && after.size() == before.size() + 1 && after.hasAll(before);
    }
    function validDiscussionAuthor(projectId, entry) {
      return entry.email == request.auth.token.email && entry.timestamp is string
        && entry.role == (superuser(projectId) ? 'admin' : role(projectId));
    }
    function inspectionComment(projectId) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      let comments = request.resource.data.get('comments', []);
      return member(projectId) && changes.hasOnly(['comments', 'updatedBy', 'updatedAt'])
        && appendOnly('comments') && validDiscussionAuthor(projectId, comments[comments.size() - 1])
        && comments[comments.size() - 1].text is string && comments[comments.size() - 1].text.size() > 0;
    }
    // RFI workflow. Statuses: draft → opened → re_review → site_inspection → next_work → closure_applied → closed.
    // Records from the earlier five-stage workflow keep a numeric `stage` until their first transition.
    function rfiStatusOf(data) {
      return data.get('status', ['opened', 're_review', 'site_inspection', 'closure_applied', 'closed'][data.get('stage', 4)]);
    }
    function rfiNext() {
      return {'draft': 'opened', 'opened': 're_review', 're_review': 'site_inspection', 'site_inspection': 'next_work', 'next_work': 'closure_applied', 'closure_applied': 'closed'};
    }
    function rfiHistoryText() {
      return {'opened': 'Opened RFI', 're_review': 'Submitted for RE review', 'site_inspection': 'RE allowed site inspection (RTO)', 'next_work': 'RTO allowed next work', 'closure_applied': 'Applied for RFI closure', 'closed': 'RE approved closure — RFI closed'};
    }
    // Rejection and rollback (mirrors src/utils/siteData.js): the RE/RTO rejects at their stage; an engineer/manager
    // rolls a rejected RFI back (Opened up to the rejected stage) or closes it; only the site owner rolls back a
    // closed RFI. Each step appends an audit entry with a reason. `rejectedFrom` marks a rejected or closed-rejected RFI.
    function rfiIndex() {
      return {'draft': 0, 'opened': 1, 're_review': 2, 'site_inspection': 3, 'next_work': 4, 'closure_applied': 5, 'closed': 6};
    }
    function rfiLabels() {
      return {'opened': 'Opened', 're_review': 'Under RE Review', 'site_inspection': 'Site Inspection (RTO)', 'next_work': 'Next Work Allowed', 'closure_applied': 'Closure Applied'};
    }
    function rfiRejecters() { return {'re_review': 'RE', 'site_inspection': 'RTO', 'closure_applied': 'RE'}; }
    function rfiOutcomeEntry(projectId, action) {
      let history = request.resource.data.get('history', []);
      let entry = history[history.size() - 1];
      return appendOnly('history') && entry.email == request.auth.token.email && entry.timestamp is string
        && entry.role == effectiveRole(projectId) && entry.action == action
        && entry.reason is string && entry.reason.size() > 0 && entry.reason.size() <= 2000;
    }
    function inspectionReject(projectId) {
      let d = request.resource.data;
      let from = rfiStatusOf(resource.data);
      let r = effectiveRole(projectId);
      return from in rfiRejecters() && r in ['admin', rfiRejecters()[from]]
        && d.status == 'rejected' && d.rejectedFrom == from
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedFrom', 'history', 'updatedBy', 'updatedAt'])
        && rfiOutcomeEntry(projectId, 'Rejected at ' + rfiLabels()[from]);
    }
    function rfiRollbackTo(last) {
      let d = request.resource.data;
      return d.status in rfiLabels() && rfiIndex()[d.status] <= last && !d.keys().hasAny(['rejectedFrom'])
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedFrom', 'history', 'updatedBy', 'updatedAt']);
    }
    function inspectionResolveRejected(projectId) {
      let d = request.resource.data;
      return rfiStatusOf(resource.data) == 'rejected' && rfiRaiser(projectId)
        && (d.status == 'closed' && d.get('rejectedFrom', '') == resource.data.rejectedFrom
            && d.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedBy', 'updatedAt'])
            && rfiOutcomeEntry(projectId, 'Closed rejected RFI')
          || rfiRollbackTo(rfiIndex()[resource.data.rejectedFrom]) && rfiOutcomeEntry(projectId, 'Rolled back to ' + rfiLabels()[d.status]));
    }
    function inspectionRollbackClosed(projectId) {
      return rfiStatusOf(resource.data) == 'closed' && siteOwner() && rfiRollbackTo(5)
        && rfiOutcomeEntry(projectId, 'Site owner rolled back to ' + rfiLabels()[request.resource.data.status]);
    }
    function rfiDisciplineCodes() { return {'Structural': 'STR', 'Architectural': 'AR', 'M&E Sleeve / Conduit': 'ME'}; }
    // Engineers, managers and admins raise RFIs, submit them and apply for closure.
    function rfiRaiser(projectId) { return planner(projectId); }
    function rfiCounterPath(projectId, prefix) {
      return /databases/$(database)/documents/artifacts/$(projectId)/rfiCounters/$(prefix);
    }
    // New RFIs are numbered <Project>_<Zone>-<Discipline>-### and must advance that prefix's counter in the same write.
    function newInspection(projectId, recordId) {
      let d = request.resource.data;
      let parts = recordId.split('-');
      let seq = parts[parts.size() - 1];
      return rfiRaiser(projectId) && d.status in ['draft', 'opened'] && !d.keys().hasAny(['stage'])
        && d.get('history', []) == [] && d.get('comments', []) == [] && d.get('attachments', []) == []
        && d.discipline in rfiDisciplineCodes() && d.zone is string && d.zone.size() > 0
        && d.element is string && d.element.size() > 0
        && d.rfiPrefix is string && d.rfiPrefix.size() <= 300 && d.rfiPrefix.matches('^[^/]+_[^/]+-' + rfiDisciplineCodes()[d.discipline] + '$')
        && seq.matches('^[0-9]{3,6}$') && recordId == d.rfiPrefix + '-' + seq && d.rfiNumber is int && d.rfiNumber == int(seq)
        && getAfter(rfiCounterPath(projectId, d.rfiPrefix)).data.lastId == recordId
        && getAfter(rfiCounterPath(projectId, d.rfiPrefix)).data.last == d.rfiNumber;
    }
    function rfiCounterWrite(projectId, prefix, previous) {
      let d = request.resource.data;
      let rfi = /databases/$(database)/documents/artifacts/$(projectId)/inspections/$(d.lastId);
      return rfiRaiser(projectId) && d.last is int && d.last > previous && d.lastId is string
        && !exists(rfi) && existsAfter(rfi) && getAfter(rfi).data.rfiPrefix == prefix && getAfter(rfi).data.rfiNumber == d.last;
    }
    // Effective project role, resolved once per check to stay within the rules expression limit.
    function effectiveRole(projectId) { return superuser(projectId) ? 'admin' : role(projectId); }
    function inspectionAdvance(projectId) {
      let d = request.resource.data;
      let from = rfiStatusOf(resource.data);
      let history = d.get('history', []);
      let entry = history[history.size() - 1];
      let r = effectiveRole(projectId);
      return from in rfiNext() && d.status == rfiNext()[from]
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedBy', 'updatedAt'])
        && r in (from in ['draft', 'opened', 'next_work'] ? ['admin', 'manager', 'engineer']
          : from == 'site_inspection' ? ['admin', 'RTO'] : ['admin', 'RE'])
        && appendOnly('history') && entry.email == request.auth.token.email && entry.timestamp is string && entry.role == r
        && entry.action == rfiHistoryText()[d.status];
    }
    function inspectionDetails(projectId) {
      // Zone and discipline are part of an automatic RFI reference, so they are fixed once numbered.
      let editable = resource.data.keys().hasAny(['rfiPrefix'])
        ? ['element', 'rtoName', 'reName', 'targetCast', 'bbsLinked', 'updatedBy', 'updatedAt']
        : ['zone', 'discipline', 'element', 'rtoName', 'reName', 'targetCast', 'bbsLinked', 'updatedBy', 'updatedAt'];
      let r = effectiveRole(projectId);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(editable)
        && (r == 'admin' || r in ['manager', 'engineer'] && resource.data.createdBy == request.auth.token.email);
    }
    // RFI PDFs are stored in Firestore as binary chunks of up to 900 KiB (10 MB / 12 chunks per file).
    function rfiChunkPath(projectId, fileId, index) {
      return /databases/$(database)/documents/artifacts/$(projectId)/rfiFileChunks/$(fileId + '_' + string(index));
    }
    function validAttachment(projectId, recordId, a) {
      return a is map && a.keys().hasOnly(['fileId', 'name', 'size', 'chunks', 'contentType', 'category', 'uploadedBy', 'uploadedAt'])
        && a.fileId is string && a.fileId.matches('^[A-Za-z0-9-]{8,64}$')
        && a.name is string && a.name.size() > 0 && a.name.size() <= 200
        && a.chunks is int && a.chunks >= 1 && a.chunks <= 12
        && a.size is int && a.size > (a.chunks - 1) * 921600 && a.size <= a.chunks * 921600 && a.size <= 10485760
        && a.contentType == 'application/pdf' && a.category in ['Inspection file', 'Reference']
        && a.uploadedBy == request.auth.token.email && a.uploadedAt is string
        // The upload must be complete: the first and last chunks exist and belong to this RFI.
        && get(rfiChunkPath(projectId, a.fileId, 0)).data.rfiId == recordId
        && get(rfiChunkPath(projectId, a.fileId, a.chunks - 1)).data.total == a.chunks
        && get(rfiChunkPath(projectId, a.fileId, a.chunks - 1)).data.createdBy == request.auth.token.email;
    }
    function rfiOf(projectId, rfiId) {
      return get(/databases/$(database)/documents/artifacts/$(projectId)/inspections/$(rfiId)).data;
    }
    function newRfiFileChunk(projectId, chunkId) {
      let d = request.resource.data;
      return effectiveRole(projectId) in ['admin', 'manager', 'engineer']
        && d.keys().hasOnly(['rfiId', 'fileId', 'index', 'total', 'data', 'createdBy', 'createdAt'])
        && d.fileId is string && d.fileId.matches('^[A-Za-z0-9-]{8,64}$')
        && d.total is int && d.total >= 1 && d.total <= 12 && d.index is int && d.index >= 0 && d.index < d.total
        && chunkId == d.fileId + '_' + string(d.index)
        && d.data is bytes && d.data.size() > 0 && d.data.size() <= 921600
        && d.createdBy == request.auth.token.email && d.createdAt is string
        && d.rfiId is string && rfiStatusOf(rfiOf(projectId, d.rfiId)) in ['draft', 'opened'];
    }
    // Chunks can be removed only before RE submission, by their uploader, the RFI creator or an admin.
    // After submission they are immutable, so documents the RE reviews cannot change.
    function rfiFileChunkDelete(projectId) {
      let rfi = rfiOf(projectId, resource.data.rfiId);
      return rfiStatusOf(rfi) in ['draft', 'opened']
        && (resource.data.createdBy == request.auth.token.email || rfi.createdBy == request.auth.token.email
          || effectiveRole(projectId) == 'admin');
    }
    // Site diary entries are drafts or submitted records (no status = an entry that predates drafts, i.e. submitted).
    // JPEG photos of up to 900 KiB live in diaryPhotos and are linked or unlinked only while the entry is a draft;
    // submission is one-way and locks the photo set.
    function diaryStatusOf(data) { return data.get('status', 'submitted'); }
    function diaryEntryPath(projectId, entryId) {
      return /databases/$(database)/documents/artifacts/$(projectId)/weatherLogs/$(entryId);
    }
    function diaryPhotoPath(projectId, photoId) {
      return /databases/$(database)/documents/artifacts/$(projectId)/diaryPhotos/$(photoId);
    }
    function newDiaryEntry() {
      let d = request.resource.data;
      return d.details is string && diaryStatusOf(d) in ['draft', 'submitted']
        && d.get('photos', []) is list && d.get('photos', []).size() == 0
        && !d.keys().hasAny(['submittedBy', 'submittedAt']);
    }
    function validDiaryPhoto(projectId, recordId, p) {
      return p is map && p.keys().hasOnly(['photoId', 'name', 'size', 'width', 'height', 'contentType', 'thumb', 'uploadedBy', 'uploadedAt'])
        && p.photoId is string && p.photoId.matches('^[A-Za-z0-9-]{8,64}$')
        && p.name is string && p.name.size() > 0 && p.name.size() <= 200
        && p.size is int && p.size > 0 && p.size <= 921600
        && p.width is int && p.width > 0 && p.width <= 4096 && p.height is int && p.height > 0 && p.height <= 4096
        && p.contentType == 'image/jpeg'
        && p.thumb is string && p.thumb.size() <= 40000 && p.thumb.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')
        && p.uploadedBy == request.auth.token.email && p.uploadedAt is string
        // The photo must be uploaded in full, by this user, for this entry.
        && get(diaryPhotoPath(projectId, p.photoId)).data.entryId == recordId
        && get(diaryPhotoPath(projectId, p.photoId)).data.createdBy == request.auth.token.email
        && get(diaryPhotoPath(projectId, p.photoId)).data.data.size() == p.size;
    }
    function diaryPhotoChange(projectId, recordId) {
      let before = resource.data.get('photos', []);
      let after = request.resource.data.get('photos', []);
      let removed = before.removeAll(after);
      return diaryStatusOf(resource.data) == 'draft'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photos', 'updatedBy', 'updatedAt'])
        && after is list && after.size() <= 10
        && (after.size() == before.size() + 1 && after.hasAll(before) && validDiaryPhoto(projectId, recordId, after[after.size() - 1])
          || after.size() == before.size() - 1 && before.hasAll(after) && removed.size() == 1
            && (effectiveRole(projectId) == 'admin' || resource.data.createdBy == request.auth.token.email || removed[0].uploadedBy == request.auth.token.email));
    }
    function diaryUpdate(projectId, recordId) {
      let d = request.resource.data;
      let keys = d.diff(resource.data).affectedKeys();
      return d.details is string && (keys.hasAny(['photos']) ? diaryPhotoChange(projectId, recordId)
        : keys.hasAny(['status', 'submittedBy', 'submittedAt'])
          // Draft -> submitted only; a submitted entry never returns to draft.
          ? diaryStatusOf(resource.data) == 'draft' && d.get('status', '') == 'submitted'
            && d.get('submittedBy', '') == request.auth.token.email && d.get('submittedAt', null) is string
          : true);
    }
    function newDiaryPhoto(projectId, photoId) {
      let d = request.resource.data;
      return siteRecorder(projectId)
        && d.keys().hasOnly(['entryId', 'data', 'contentType', 'createdBy', 'createdAt'])
        && photoId.matches('^[A-Za-z0-9-]{8,64}$')
        && d.entryId is string && d.entryId.matches('^[A-Za-z0-9_-]{1,128}$')
        && d.data is bytes && d.data.size() > 0 && d.data.size() <= 921600 && d.contentType == 'image/jpeg'
        && d.createdBy == request.auth.token.email && d.createdAt is string
        && exists(diaryEntryPath(projectId, d.entryId)) && diaryStatusOf(get(diaryEntryPath(projectId, d.entryId)).data) == 'draft';
    }
    // Photo documents can be removed while the entry is a draft (uploader, entry creator or admin),
    // or by a site recorder once the entry itself has been deleted. Photos of submitted entries are immutable.
    function diaryPhotoDelete(projectId) {
      let entry = diaryEntryPath(projectId, resource.data.entryId);
      return siteRecorder(projectId) && (!exists(entry)
        || diaryStatusOf(get(entry).data) == 'draft' && (resource.data.createdBy == request.auth.token.email
          || get(entry).data.get('createdBy', '') == request.auth.token.email || effectiveRole(projectId) == 'admin'));
    }
    // PDFs are attached or unlinked only before the RFI is submitted for RE review.
    function inspectionAttachments(projectId, recordId) {
      let before = resource.data.get('attachments', []);
      let after = request.resource.data.get('attachments', []);
      let removed = before.removeAll(after);
      let r = effectiveRole(projectId);
      return rfiStatusOf(resource.data) in ['draft', 'opened']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments', 'updatedBy', 'updatedAt'])
        && after is list && after.size() <= 20 && r in ['admin', 'manager', 'engineer']
        && (after.size() == before.size() + 1 && after.hasAll(before) && validAttachment(projectId, recordId, after[after.size() - 1])
          || after.size() == before.size() - 1 && before.hasAll(after) && removed.size() == 1
            && (r == 'admin' || resource.data.createdBy == request.auth.token.email || removed[0].uploadedBy == request.auth.token.email));
    }
    function inspectionUpdate(projectId, recordId) {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return keys.hasAny(['comments']) ? inspectionComment(projectId)
        : keys.hasAny(['status', 'history']) ? (inspectionAdvance(projectId) || inspectionReject(projectId)
          || inspectionResolveRejected(projectId) || inspectionRollbackClosed(projectId))
        : keys.hasAny(['attachments']) ? inspectionAttachments(projectId, recordId)
        : inspectionDetails(projectId);
    }
    function organizationUpdate(projectId) {
      return (admin(projectId) || role(projectId) == 'manager') && request.resource.data.organization is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organization', 'updatedBy', 'updatedAt']);
    }
    function personalProfileUpdate(recordId) {
      let d = request.resource.data;
      return verifiedEmail() && recordId == request.auth.token.email.lower()
        && d.diff(resource.data).affectedKeys().hasOnly(['name', 'role', 'phone', 'birthday', 'updatedBy', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.role is string && d.role.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.birthday is string && (d.birthday == '' || d.birthday.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function deletionTarget(projectId, collectionName, recordId) {
      return collectionName == 'projects' ? /databases/$(database)/documents/projects/$(projectId)
        : /databases/$(database)/documents/artifacts/$(projectId)/$(collectionName)/$(recordId);
    }
    function deletable(collectionName) {
      return collectionName in ['tasks', 'materials', 'lifts', 'inspections', 'weatherLogs', 'users', 'zones', 'monitoring', 'projects'];
    }
    function deletionReviewer(projectId) { return admin(projectId) || role(projectId) == 'manager'; }
    function validDeletionEvent() {
      let d = request.resource.data;
      let history = d.history;
      let previous = resource == null ? [] : resource.data.get('history', []);
      let entry = history[history.size() - 1];
      return history is list && history.size() == previous.size() + 1 && history == previous.concat([entry])
        && entry.keys().hasOnly(['status', 'by', 'byUid', 'at', 'reason'])
        && entry.status == d.status && entry.by == request.auth.token.email && entry.byUid == request.auth.uid
        && entry.at is timestamp && entry.reason == (d.status in ['approved', 'rejected'] ? d.reviewReason : d.reason);
    }
    function validDeletionShape(projectId, key) {
      let d = request.resource.data;
      return d.keys().hasOnly(['targetCollection', 'targetId', 'targetLabel', 'targetSnapshot', 'reason', 'requestedBy', 'requestedByUid', 'requestedAt', 'status', 'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewReason', 'history'])
        && deletable(d.targetCollection) && d.targetId is string && d.targetId.size() > 0
        && key == d.targetCollection + ':' + d.targetId && (d.targetCollection != 'projects' || d.targetId == projectId && siteOwner())
        && d.targetLabel is string && d.targetSnapshot is map && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 2000
        && d.reviewReason is string && d.reviewReason.size() <= 2000 && validDeletionEvent();
    }
    function newDeletionRequest(projectId, key) {
      let d = request.resource.data;
      let target = deletionTarget(projectId, d.targetCollection, d.targetId);
      return validDeletionShape(projectId, key) && exists(target) && d.targetSnapshot == get(target).data
        && d.requestedBy == request.auth.token.email && d.requestedByUid == request.auth.uid && d.requestedAt == request.time
        && (d.status == 'pending' && member(projectId) && get(target).data.get('createdBy', '').lower() == request.auth.token.email.lower()
          && d.reviewedBy == '' && d.reviewedByUid == '' && d.reviewedAt == null && d.reviewReason == ''
          || d.status == 'deleted' && admin(projectId) && !existsAfter(target)
          && d.reviewedBy == request.auth.token.email && d.reviewedByUid == request.auth.uid && d.reviewedAt == request.time);
    }
    function reviewedDeletionRequest(projectId, key) {
      let d = request.resource.data;
      let previous = resource.data;
      let target = deletionTarget(projectId, previous.targetCollection, previous.targetId);
      return validDeletionShape(projectId, key) && previous.status == 'pending' && deletionReviewer(projectId)
        && (admin(projectId) || previous.requestedByUid != request.auth.uid)
        && d.diff(previous).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewReason', 'history'])
        && d.reviewedBy == request.auth.token.email && d.reviewedByUid == request.auth.uid && d.reviewedAt == request.time && d.reviewReason.size() > 0
        && (d.status == 'rejected' || d.status == 'approved' && exists(target) && previous.targetSnapshot == get(target).data && !existsAfter(target));
    }
    function verifiedRecordDelete(projectId, collectionName, recordId) {
      let path = /databases/$(database)/documents/artifacts/$(projectId)/deletionRequests/$(collectionName + ':' + recordId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return role(projectId) == 'manager' && before.status == 'pending' && before.requestedByUid != request.auth.uid
        && before.targetSnapshot == resource.data && after.status == 'approved'
        && after.reviewedByUid == request.auth.uid && after.reviewedAt == request.time;
    }
    match /artifacts/{projectId}/deletionRequests/{key} {
      allow read: if member(projectId);
      allow create: if signedIn() && newDeletionRequest(projectId, key);
      allow update: if signedIn() && (reviewedDeletionRequest(projectId, key)
        || (resource.data.status == 'rejected' || admin(projectId)) && newDeletionRequest(projectId, key));
      // Retain verification history after the operational record is deleted.
    }
    match /artifacts/{projectId}/rfiCounters/{prefix} {
      // Read access comes from the project-records match below; counters are never deleted so numbers are not reused.
      allow create: if auditCreate() && rfiCounterWrite(projectId, prefix, 0)
        && request.resource.data.keys().hasOnly(['last', 'lastId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt']);
      allow update: if auditUpdate() && rfiCounterWrite(projectId, prefix, resource.data.last)
        && request.resource.data.keys().hasOnly(['last', 'lastId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt']);
    }
    match /artifacts/{projectId}/rfiFileChunks/{chunkId} {
      // Read access comes from the project-records match below.
      allow create: if newRfiFileChunk(projectId, chunkId);
      allow delete: if rfiFileChunkDelete(projectId);
    }
    match /artifacts/{projectId}/diaryPhotos/{photoId} {
      // Read access comes from the project-records match below.
      allow create: if newDiaryPhoto(projectId, photoId);
      allow delete: if diaryPhotoDelete(projectId);
    }
    match /siteOwners/{uid} {
      allow read: if signedIn() && uid == request.auth.uid;
    }
    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if siteOwner() && request.resource.data.ownerId == request.auth.uid && auditCreate()
        && request.resource.data.keys().hasOnly(['name', 'id', 'ownerId', 'createdBy', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.get('id', projectId) == projectId;
      allow update: if superuser(projectId) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if siteOwner();
    }
    match /artifacts/{projectId}/{collectionName}/{recordId} {
      allow read: if member(projectId) || collectionName == 'users' && verifiedEmail() && recordId == request.auth.token.email.lower();
      allow delete: if deletable(collectionName) && (admin(projectId) || verifiedRecordDelete(projectId, collectionName, recordId));
      allow create: if auditCreate() && (
        (collectionName == 'tasks' && planner(projectId) && validTask()) ||
        (collectionName == 'materials' && siteRecorder(projectId) && validMaterial()) ||
        (collectionName == 'weatherLogs' && siteRecorder(projectId) && newDiaryEntry()) ||
        (collectionName in ['zones', 'lifts'] && planner(projectId)) ||
        (collectionName == 'inspections' && newInspection(projectId, recordId)) ||
        (collectionName == 'monitoring' && admin(projectId) && request.resource.data.confirmedBy == request.auth.token.email && request.resource.data.confirmedAt is string) ||
        // Self-registration only files a pending access request; an admin assigns the role that grants access.
        (collectionName == 'users' && recordId == request.resource.data.email.lower() && (selfProfile(projectId, recordId)
          || admin(projectId) && request.resource.data.systemRole in ['guest', 'supervisor', 'engineer', 'manager', 'RE', 'RTO', 'admin']))
      );
      allow update: if auditUpdate() && (
        (collectionName == 'tasks' && planner(projectId) && validTask()) ||
        (collectionName == 'materials' && siteRecorder(projectId) && validMaterial()) ||
        (collectionName == 'weatherLogs' && siteRecorder(projectId) && diaryUpdate(projectId, recordId)) ||
        (collectionName in ['zones', 'lifts'] && planner(projectId)) ||
        (collectionName == 'inspections' && inspectionUpdate(projectId, recordId)) ||
        (collectionName == 'users' && (organizationUpdate(projectId) || personalProfileUpdate(recordId))) ||
        (collectionName == 'users' && admin(projectId) && recordId == request.resource.data.email.lower()
          && request.resource.data.systemRole in ['guest', 'supervisor', 'engineer', 'manager', 'RE', 'RTO', 'admin'])
      );
      // Observations cannot be edited; deletion follows the same admin/verification policy.
    }
  }
}
