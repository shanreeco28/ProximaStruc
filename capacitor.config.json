{
  "appId": "com.proximastruc.app",
  "appName": "ProximaStruc",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true,
            "traits": ["Google"]
          }
        }
      }
    }
  }
}
