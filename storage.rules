rules_version = '2';
// ProximaStruc does not store files in Cloud Storage (RFI PDFs and site diary photos are kept in Firestore).
// Deny all access so the project's default bucket cannot be read or written from client apps.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
